{
  "name": "kestral-excalidraw",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19 <23"
  },
  "description": "An Excalidraw whiteboard packaged as an ordinary Kestral app.",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && npm run notices && vite build && node scripts/build-package.mjs",
    "dev": "vite",
    "test": "npm run build && node --test test/*.test.mjs && vitest run",
    "test:package-schema": "node test/package-schema.mjs",
    "test:reproducible": "node test/reproducible.mjs",
    "package:digest": "node scripts/package-digest.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "test:frontend": "vitest run",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.11",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "ajv": "8.20.0",
    "jsdom": "29.1.1",
    "nanoid": "3.3.18",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.18"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16",
      "mermaid": "11.16.1"
    },
    "dompurify": "3.4.15",
    "fast-uri": "3.1.6",
    "lodash-es": "4.18.1",
    "nanoid@<=3.3.17": "3.3.18"
  }
}
